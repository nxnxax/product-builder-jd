# Force HTTPS — newly installed SSL certificate.
RewriteEngine On
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP:X-Forwarded-Proto} =http
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

# Basic security headers (cafe24/openresty respects most of these).
<IfModule mod_headers.c>
    Header always set Strict-Transport-Security "max-age=15552000; includeSubDomains"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

# Make sure proxies serve fresh HTML so users pick up new deploys quickly.
<IfModule mod_headers.c>
    <FilesMatch "\.(html|htm)$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
</IfModule>

# Belt-and-braces: deny direct web access to dotfiles / env / secrets.
<FilesMatch "^\.">
    Require all denied
</FilesMatch>
<FilesMatch "(^|/)\.env(\.|$)">
    Require all denied
</FilesMatch>

# 사장님 2026-05-21 — APK 다운로드 (베타 테스터용).
# /download/youngman-latest.apk → Android 패키지 인스톨러 자동 열림.
AddType application/vnd.android.package-archive .apk
<FilesMatch "\.apk$">
    Header set Content-Disposition "attachment; filename=\"youngman-latest.apk\""
    Header set Cache-Control "public, max-age=300"
</FilesMatch>
